# Server Configuration
# Bind locally when running behind nginx. Containers should override this with
# SERVER_HOST=0.0.0.0 when the API must be reachable outside the container.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/counter_api?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_IDLE_TIME_SECONDS=300
DB_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=2000
DB_LOCK_TIMEOUT_MS=500
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000

# Request and process protection
REQUEST_READ_TIMEOUT_SECONDS=5
REQUEST_MUTATION_TIMEOUT_SECONDS=10
SERVER_READ_TIMEOUT_SECONDS=10
SERVER_WRITE_TIMEOUT_SECONDS=10
SERVER_IDLE_TIMEOUT_SECONDS=30
SERVER_CONCURRENCY=128
SERVER_MAX_CONNS_PER_IP=100
MAX_REQUEST_BODY_BYTES=65536

# Security
API_KEY=your-secret-api-key-here
# Keep enabled for V1 compatibility until clients migrate to V2 credentials.
LEGACY_API_KEY_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_GET_MULTIPLIER=3
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CLEANUP=300
# Optional shared rate-limit state; Redis is not required.
RATE_LIMIT_REDIS_URL=

# Counter GET read-through cache. Uses Redis when configured, otherwise a
# bounded per-process in-memory cache. Defaults preserve the former cache size/TTL.
COUNTER_READ_CACHE_REDIS_URL=
COUNTER_READ_CACHE_MAX_ENTRIES=1000
COUNTER_READ_CACHE_TTL_SECONDS=300

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://example.com,https://sub.example.com
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,X-API-Key,Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# Logging
LOG_LEVEL=info

# Sentry Configuration
# Leave SENTRY_DSN empty to disable Sentry integration
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE is optional - if unset, defaults to binary version (set via ldflags)
# Only override for special cases like "1.0.3+canary" or specific deployment tracking
SENTRY_SAMPLE_RATE=0.5
